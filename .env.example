# ==============================================================================
# Invisible Grills & Safety Solutions Website - Environment Template
# Copy this file to .env and configure values before production launch.
# ==============================================================================

# Site & Branding
VITE_SITE_URL="https://invisprotect.in"
VITE_BRAND_NAME=""
SITE_BRAND_NAME=""

# Supabase Database & Authentication Infrastructure
SUPABASE_URL=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Note: VITE_SUPABASE_ANON_KEY is also accepted as an alias for VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=""

# Meta WhatsApp Cloud API (Server-Side Owner Lead Notifications)
WHATSAPP_API_TOKEN=""
# Note: WHATSAPP_ACCESS_TOKEN is also accepted as an alias for WHATSAPP_API_TOKEN
WHATSAPP_PHONE_NUMBER_ID=""
OWNER_WHATSAPP_PHONE=""
# Note: WHATSAPP_NOTIFICATION_RECIPIENT is also accepted as an alias for OWNER_WHATSAPP_PHONE

# Google Ads Measurement
VITE_GADS_ACCOUNT_ID=""
# Note: VITE_GOOGLE_ADS_ID is also accepted as an alias for VITE_GADS_ACCOUNT_ID
VITE_GADS_PRIMARY_LEAD_CONVERSION=""
# Note: VITE_GOOGLE_ADS_CONVERSION_LABEL is also accepted as an alias for VITE_GADS_PRIMARY_LEAD_CONVERSION
