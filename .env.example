# ==============================================================================
# InvisProtect production environment template
# Keep secrets blank in source control.
# ==============================================================================

# Site / brand
VITE_SITE_STATUS="pending"
VITE_SITE_URL="https://invisprotect.in"
VITE_BRAND_NAME="InvisProtect"
SITE_BRAND_NAME="InvisProtect"

# Social channels (optional overrides; defaults point to official InvisProtect channels)
VITE_SOCIAL_INSTAGRAM_URL=""
VITE_SOCIAL_FACEBOOK_URL=""
VITE_SOCIAL_YOUTUBE_URL=""

# Contact configuration
# Contact actions and lead forms require active site status, contact enabled, and valid Call and WhatsApp destinations.
VITE_CONTACT_ENABLED="false"
VITE_BUSINESS_PHONE_DISPLAY=""
VITE_BUSINESS_PHONE_DIAL=""
VITE_BUSINESS_WHATSAPP_DISPLAY=""
VITE_BUSINESS_WHATSAPP_DIAL=""
VITE_BUSINESS_WHATSAPP_LINK=""
VITE_BUSINESS_EMAIL=""

# Supabase (server-side lead persistence)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional public Supabase configuration for future authenticated browser features.
# The current public lead flow does not expose or require the service-role key in the browser.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Meta WhatsApp Cloud API (server-side owner notifications)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
OWNER_WHATSAPP_PHONE=""

# Google Ads direct tag
VITE_GADS_ACCOUNT_ID=""
VITE_GADS_PRIMARY_LEAD_CONVERSION=""

# Optional non-negative lead value. Leave blank during initial lead-validation mode.
VITE_GADS_LEAD_VALUE=""
